.tarot-card {
  border-radius: var(--radius-sm);
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 尺寸 */
.card-small {
  width: 100rpx;
  height: 160rpx;
}

.card-normal {
  width: 160rpx;
  height: 256rpx;
}

.card-large {
  width: 240rpx;
  height: 384rpx;
}

/* 牌背 */
.card-back {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a1a3e, #2d1b4e);
  border: 2rpx solid rgba(201, 168, 76, 0.4);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-pattern {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card-star {
  font-size: 40rpx;
  color: rgba(201, 168, 76, 0.5);
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 16rpx;
  color: rgba(201, 168, 76, 0.5);
  letter-spacing: 4rpx;
}

/* 牌面 */
.card-front {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0d0d1a 0%, #1a1a2e 100%);
  border: 2rpx solid var(--color-accent);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.card-name {
  font-size: var(--font-md);
  color: var(--color-accent);
  font-weight: 700;
  margin-bottom: 4rpx;
}

.card-en {
  font-size: var(--font-xs);
  color: rgba(201, 168, 76, 0.6);
  margin-bottom: 8rpx;
}

.card-keywords {
  font-size: 16rpx;
  color: #888;
  line-height: 1.4;
}

.card-position {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-primary-light);
  padding: 2rpx 12rpx;
  background: rgba(107, 63, 160, 0.2);
  border-radius: 100rpx;
}

/* 翻开动画 */
.hidden {
  cursor: pointer;
}

.hidden:active {
  transform: scale(0.95);
}
