/* 主题色变量 */
page {
  --color-primary: #6b3fa0;
  --color-primary-light: #9b7fc4;
  --color-accent: #c9a84c;
  --color-bg: #f5e6d3;
  --color-bg-dark: #1a1a2e;
  --color-text: #2c2c2c;
  --color-text-light: #6b6b6b;
  --color-card-bg: #0d0d1a;
  --color-white: #ffffff;

  --font-xl: 36rpx;
  --font-lg: 32rpx;
  --font-md: 28rpx;
  --font-sm: 24rpx;
  --font-xs: 20rpx;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  --shadow-card: 0 4rpx 20rpx rgba(107, 63, 160, 0.3);

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--color-text);
  font-size: var(--font-md);
  line-height: 1.6;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 全局按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: var(--font-lg);
  padding: 24rpx 48rpx;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #999;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 48rpx;
  font-size: var(--font-md);
  padding: 20rpx 48rpx;
}

.btn-block {
  width: 100%;
}

.btn-small {
  font-size: var(--font-sm);
  padding: 12rpx 32rpx;
}

/* 加载动画 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 168, 76, 0.2);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
