.container {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spread-card {
  width: 100%;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 48rpx;
}

.spread-icon {
  font-size: 64rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.spread-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.spread-desc {
  font-size: var(--font-sm);
  color: var(--color-text-light);
  text-align: center;
  line-height: 1.8;
}

.spread-detail {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #eee;
}

.detail-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.position-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.position-num {
  width: 48rpx;
  height: 48rpx;
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.position-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

.position-meaning {
  font-size: var(--font-sm);
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.match-hint {
  margin-top: 24rpx;
  font-size: var(--font-xs);
  color: var(--color-accent);
  text-align: center;
  font-style: italic;
}

.actions {
  width: 100%;
}

.confirm-btn {
  margin-bottom: 20rpx;
}

.back-btn {
  color: var(--color-text-light);
}
