<view class="container">
  <view class="spread-card" wx:if="{{spread}}">
    <view class="spread-icon">🔮</view>
    <view class="spread-name">{{spread.name}}</view>
    <view class="spread-desc">{{spread.description}}</view>

    <view class="spread-detail">
      <view class="detail-title">牌阵包含 {{spread.card_count}} 张牌</view>

      <view class="positions">
        <view class="position-item" wx:for="{{spread.positions}}" wx:key="index">
          <view class="position-num">{{index + 1}}</view>
          <view class="position-info">
            <view class="position-name">{{item.name}}</view>
            <view class="position-meaning">{{item.meaning}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="match-hint">
      根据你的问题「{{question}}」，系统为你匹配了此牌阵
    </view>
  </view>

  <view class="actions" wx:if="{{!loading}}">
    <button class="btn-primary btn-block" bindtap="onConfirm">
      确认牌阵，开始抽牌 ✨
    </button>
    <button class="btn-ghost btn-block" bindtap="onBack">
      返回修改信息
    </button>
  </view>
</view>
