<view class="container">
  <!-- 加载中 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-icon">🔮</view>
    <text class="loading-text">正在连接宇宙能量，为你解读...</text>
  </view>

  <!-- 结果 -->
  <view class="result-area" wx:if="{{!loading && reading}}">
    <!-- 牌阵标题 -->
    <view class="section-header">🃏 你的牌阵</view>

    <!-- 卡牌展示 -->
    <view class="cards-row" wx:if="{{positions.length}}">
      <view class="card-display" wx:for="{{positions}}" wx:key="index" wx:if="{{item.card}}">
        <!-- 牌面图片 -->
        <image class="card-image" src="{{item.card.imageUrl}}" mode="aspectFill" />
        <!-- 牌名 -->
        <view class="card-zh">{{item.card.name_zh}}</view>
        <view class="card-en">{{item.card.name_en}}</view>
        <!-- 正逆位 + 位置 -->
        <view class="card-tags">
          <text class="tag-pos">{{item.name}}</text>
          <text class="tag-reverse {{item.reversed ? 'reversed' : 'upright'}}">{{item.reversed ? '逆位' : '正位'}}</text>
        </view>
        <!-- 含义 -->
        <view class="card-meaning">{{item.reversed && item.card.meaning_reversed ? item.card.meaning_reversed : item.card.meaning_upright}}</view>
      </view>
    </view>

    <!-- 逐牌解读 -->
    <block wx:if="{{reading.interpretations}}">
      <view class="reading-section" wx:for="{{reading.interpretations}}" wx:key="position" wx:for-item="interp">
        <view class="reading-title">
          <text class="position-badge">{{interp.position}}</text>
          <text>{{interp.card_name}}</text>
        </view>
        <rich-text nodes="{{interp.interpretationHtml}}" class="reading-content"></rich-text>
      </view>
    </block>

    <!-- 总结 -->
    <view class="summary-section" wx:if="{{reading.summaryHtml}}">
      <view class="summary-title">🌟 综合分析</view>
      <rich-text nodes="{{reading.summaryHtml}}" class="summary-content"></rich-text>
    </view>
  </view>

  <!-- 错误 -->
  <view class="fallback-area" wx:if="{{!loading && !reading}}">
    <view class="fallback-icon">😔</view>
    <view class="fallback-text">解读服务暂时不可用</view>
    <view class="fallback-hint">{{errorMsg || '请稍后重试'}}</view>
  </view>

  <button class="btn-primary btn-block" bindtap="onRestart" wx:if="{{!loading}}">
    重新占卜 🔮
  </button>
</view>
