.container {
  min-height: 100vh;
  padding: 32rpx;
  background: var(--color-bg-dark);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.loading-text {
  margin-top: 24rpx;
  color: var(--color-accent);
  font-size: var(--font-md);
}

.result-area {
  width: 100%;
}

.cards-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.result-card {
  width: 200rpx;
  background: linear-gradient(135deg, #1a1a3e, #2d1b4e);
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.card-position {
  font-size: var(--font-xs);
  color: var(--color-accent);
  margin-bottom: 8rpx;
}

.card-name {
  font-size: var(--font-md);
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-keywords {
  font-size: var(--font-xs);
  color: #999;
}

.reading-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid var(--color-accent);
}

.reading-title {
  font-size: var(--font-md);
  color: var(--color-accent);
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.position-badge {
  display: inline-block;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.reading-content {
  font-size: var(--font-sm);
  color: #ccc;
  line-height: 1.8;
}

.summary-section {
  background: linear-gradient(135deg, rgba(107, 63, 160, 0.2), rgba(201, 168, 76, 0.15));
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.summary-title {
  font-size: var(--font-lg);
  color: var(--color-accent);
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: center;
}

.summary-content {
  font-size: var(--font-md);
  color: #ddd;
  line-height: 1.8;
}

.fallback-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 40vh;
}

.fallback-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.fallback-text {
  color: #999;
  font-size: var(--font-md);
  margin-bottom: 8rpx;
}

.fallback-hint {
  color: #666;
  font-size: var(--font-sm);
}

.restart-btn {
  margin-top: 32rpx;
  margin-bottom: 48rpx;
}
