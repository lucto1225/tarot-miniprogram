.container {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  background: var(--color-bg-dark);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 加载 */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-icon {
  font-size: 80rpx;
  margin-top: 32rpx;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.loading-text {
  margin-top: 32rpx;
  color: var(--color-accent);
  font-size: var(--font-md);
}

.result-area {
  width: 100%;
  padding-bottom: 32rpx;
}

/* 标题 */
.section-header {
  text-align: center;
  font-size: var(--font-lg);
  color: var(--color-accent);
  font-weight: 700;
  margin-bottom: 32rpx;
}

/* ========== 卡牌展示 ========== */
.cards-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.card-display {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 牌面图片 */
.card-image {
  width: 220rpx;
  height: 370rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(201, 168, 76, 0.5);
  box-shadow: 0 4rpx 24rpx rgba(201, 168, 76, 0.2);
  background: linear-gradient(180deg, #1a1040 0%, #0d0d1a 100%);
}

.card-zh {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.3;
}

.card-en {
  font-size: 18rpx;
  color: rgba(201, 168, 76, 0.7);
  text-align: center;
  line-height: 1.3;
  margin-top: 4rpx;
}

/* 正逆位 + 位置标签 */
.card-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag-pos {
  font-size: 20rpx;
  color: var(--color-accent);
  padding: 2rpx 14rpx;
  background: rgba(201, 168, 76, 0.1);
  border-radius: 100rpx;
}

.tag-reverse {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}

.tag-reverse.upright {
  color: #4caf50;
  background: rgba(76, 175, 80, 0.1);
}

.tag-reverse.reversed {
  color: #f44336;
  background: rgba(244, 67, 54, 0.1);
}

/* 含义 */
.card-meaning {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #888;
  text-align: center;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 解读 ========== */
.reading-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid var(--color-accent);
}

.reading-title {
  font-size: var(--font-md);
  color: var(--color-accent);
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.position-badge {
  display: inline-block;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.reading-content {
  font-size: var(--font-sm);
  color: #ccc;
  line-height: 1.8;
}

/* ========== 总结 ========== */
.summary-section {
  background: linear-gradient(135deg, rgba(107, 63, 160, 0.2), rgba(201, 168, 76, 0.15));
  border-radius: var(--radius-md);
  padding: 32rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.summary-title {
  font-size: var(--font-lg);
  color: var(--color-accent);
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: center;
}

.summary-content {
  font-size: var(--font-md);
  color: #ddd;
  line-height: 1.8;
}

/* ========== 错误 ========== */
.fallback-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 40vh;
}

.fallback-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.fallback-text { color: #999; font-size: var(--font-md); margin-bottom: 8rpx; }
.fallback-hint { color: #666; font-size: var(--font-sm); }
