.container {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-bg);
}

.form-card {
  width: 100%;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 48rpx;
}

.form-title {
  font-size: var(--font-lg);
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 40rpx;
  font-weight: 600;
}

.form-item {
  width: 100%;
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: var(--font-md);
  color: var(--color-text);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-value {
  padding: 20rpx 24rpx;
  background: #f8f4f0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--color-text);
}

.form-value.placeholder {
  color: var(--color-text-light);
}

.form-input {
  display: block;
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f8f4f0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  box-sizing: border-box;
  height: auto;
  min-height: 64rpx;
  line-height: 1.5;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f4f0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: var(--font-lg);
  padding: 24rpx 0;
}

.submit-btn.disabled,
.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}
