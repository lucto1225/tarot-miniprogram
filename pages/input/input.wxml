<view class="container">
  <view class="form-card">
    <view class="form-title">✨ 请填写信息，开始你的塔罗之旅</view>

    <!-- 出生日期 - 原生 picker -->
    <view class="form-item">
      <text class="form-label">📅 出生日期</text>
      <picker
        mode="date"
        value="{{birthday}}"
        start="1900-01-01"
        end="{{today}}"
        bindchange="onBirthdayChange"
      >
        <view class="form-value {{birthday ? '' : 'placeholder'}}">
          {{birthday || '请选择出生日期'}}
        </view>
      </picker>
    </view>

    <!-- 性别 - 原生 picker -->
    <view class="form-item">
      <text class="form-label">⚤ 性别</text>
      <picker
        mode="selector"
        range="{{genderOptions}}"
        value="{{genderIndex}}"
        bindchange="onGenderChange"
      >
        <view class="form-value {{gender ? '' : 'placeholder'}}">
          {{gender || '请选择性别'}}
        </view>
      </picker>
    </view>

    <!-- 出生城市 -->
    <view class="form-item">
      <text class="form-label">🏙 出生城市</text>
      <input
        class="form-input"
        value="{{birthCity}}"
        placeholder="请输入出生城市，如：北京"
        bindinput="onCityInput"
      />
    </view>

    <!-- 占卜问题 -->
    <view class="form-item">
      <text class="form-label">🔮 你想占卜的问题</text>
      <textarea
        class="form-textarea"
        value="{{question}}"
        placeholder="例如：我最近三个月的感情运势如何？"
        maxlength="200"
        auto-height
        bindinput="onQuestionInput"
      />
      <text class="char-count">{{question.length || 0}}/200</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button
    class="submit-btn {{!birthday || !gender || !question ? 'disabled' : ''}}"
    disabled="{{!birthday || !gender || !question}}"
    bindtap="onSubmit"
  >
    开始占卜 ✨
  </button>
</view>
