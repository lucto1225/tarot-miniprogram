<view class="container">
  <view class="form-card">
    <view class="form-title">✨ 请填写信息，开始你的塔罗之旅</view>

    <!-- 生日 -->
    <view class="form-item" bindtap="onBirthdayTap">
      <text class="form-label">📅 出生日期</text>
      <view class="form-value {{birthday ? '' : 'placeholder'}}">
        {{birthday || '请选择出生日期'}}
      </view>
    </view>
    <van-popup show="{{ showBirthday }}" position="bottom" bind:close="onBirthdayClose">
      <van-datetime-picker
        type="date"
        value="{{ currentDate }}"
        min-date="{{ minDate }}"
        max-date="{{ maxDate }}"
        bind:confirm="onBirthdayConfirm"
        bind:cancel="onBirthdayClose"
      />
    </van-popup>

    <!-- 性别 -->
    <view class="form-item">
      <text class="form-label">⚤ 性别</text>
      <van-radio-group value="{{ gender }}" bind:change="onGenderChange" direction="horizontal">
        <van-radio name="male" custom-class="radio-item">男</van-radio>
        <van-radio name="female" custom-class="radio-item">女</van-radio>
      </van-radio-group>
    </view>

    <!-- 出生城市 -->
    <view class="form-item">
      <text class="form-label">🏙 出生城市</text>
      <van-field
        value="{{ birthCity }}"
        placeholder="请输入出生城市，如：北京"
        bind:change="onCityChange"
        border="{{ false }}"
        custom-class="city-field"
      />
    </view>

    <!-- 占卜问题 -->
    <view class="form-item">
      <text class="form-label">🔮 你想要占卜的问题</text>
      <van-field
        value="{{ question }}"
        type="textarea"
        placeholder="例如：我最近三个月的感情运势如何？"
        autosize
        maxlength="200"
        bind:change="onQuestionInput"
        border="{{ false }}"
        custom-class="question-field"
      />
      <text class="char-count">{{question.length || 0}}/200</text>
    </view>
  </view>

  <van-button
    type="primary"
    block
    round
    disabled="{{ !birthday || !gender || !question }}"
    bind:click="onSubmit"
    custom-class="submit-btn"
  >
    开始占卜 ✨
  </van-button>
</view>
