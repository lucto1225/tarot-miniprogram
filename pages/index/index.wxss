page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 80rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.logo-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: var(--font-md);
  color: var(--color-text-light);
}

/* 用户信息 */
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.userinfo-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid var(--color-accent);
}

.userinfo-nickname {
  font-size: var(--font-lg);
  color: var(--color-text);
  margin-bottom: 32rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-bottom: 32rpx;
  background: transparent;
  border: none;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px 0;
  box-sizing: border-box;
  color: var(--color-text);
  margin-bottom: 32rpx;
}

.nickname-label {
  width: 80rpx;
  flex-shrink: 0;
  font-size: var(--font-md);
}

.nickname-input {
  flex: 1;
  font-size: var(--font-md);
}

/* 按钮 */
.start-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: var(--font-lg);
  padding: 24rpx 0;
  margin-top: 16rpx;
}

.start-btn[disabled] {
  background: #ccc;
  color: #999;
}

.login-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: var(--font-lg);
  padding: 24rpx 0;
}

.version-tip {
  color: var(--color-text-light);
  font-size: var(--font-sm);
  text-align: center;
  margin-top: 16rpx;
}

/* 底部 */
.footer-tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 40rpx;
}

.tip-item {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}
